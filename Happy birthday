<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Birthday Surprise 🎂</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #ffd6e7, #e7d6ff);
      overflow: hidden;
      text-align: center;
    }

    .card {
      width: 90%;
      max-width: 500px;
      padding: 35px 25px;
      background: rgba(255,255,255,0.9);
      border-radius: 25px;
      box-shadow: 0 15px 40px rgba(0,0,0,0.15);
      position: relative;
      z-index: 2;
    }

    h1 {
      font-size: 42px;
      margin: 10px 0;
      color: #ff4f91;
    }

    h2 {
      color: #7b4ab5;
      margin-bottom: 15px;
    }

    p {
      font-size: 18px;
      line-height: 1.6;
      color: #444;
    }

    button {
      margin-top: 20px;
      padding: 14px 28px;
      border: none;
      border-radius: 30px;
      background: #ff5c9a;
      color: white;
      font-size: 17px;
      cursor: pointer;
      transition: 0.3s;
    }

    button:hover {
      transform: scale(1.08);
      background: #e83f82;
    }

    #surprise {
      display: none;
      margin-top: 20px;
      animation: pop 0.6s ease;
    }

    .heart {
      position: fixed;
      bottom: -30px;
      font-size: 25px;
      animation: float 5s linear infinite;
      z-index: 1;
    }

    @keyframes float {
      0% {
        transform: translateY(0) rotate(0deg);
        opacity: 1;
      }
      100% {
        transform: translateY(-110vh) rotate(360deg);
        opacity: 0;
      }
    }

    @keyframes pop {
      0% {
        transform: scale(0);
      }
      100% {
        transform: scale(1);
      }
    }
  </style>
</head>

<body>

  <div class="card">
    <div style="font-size:70px;">🎂</div>

    <h1>Happy Birthday! 🎉</h1>

    <h2>✨ A Little Surprise For You ✨</h2>

    <p>
      Wishing you a very happy birthday! 💖<br>
      May your special day be filled with happiness,
      beautiful memories and lots of smiles. 🌸
    </p>

    <button onclick="showSurprise()">
      🎁 Open Your Surprise
    </button>

    <div id="surprise">
      <h2>🎊 Surprise! 🎊</h2>
      <p>
        May all your dreams come true. ✨<br>
        Keep smiling, keep shining and enjoy your day! 💕
      </p>

      <div style="font-size:45px;">
        🎈 🎁 🥳 🎂 🎈
      </div>
    </div>
  </div>

  <script>
    function showSurprise() {
      document.getElementById("surprise").style.display = "block";

      for (let i = 0; i < 20; i++) {
        let heart = document.createElement("div");
        heart.className = "heart";
        heart.innerHTML = ["💖","💕","💗","✨","🎈"][Math.floor(Math.random()*5)];

        heart.style.left = Math.random() * 100 + "vw";
        heart.style.animationDuration = (3 + Math.random() * 3) + "s";

        document.body.appendChild(heart);

        setTimeout(() => {
          heart.remove();
        }, 6000);
      }
    }
  </script>

</body>
</html>
